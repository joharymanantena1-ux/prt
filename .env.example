# Contact form configuration — read by src/components/sections/ContactSection.tsx
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# When unset, the component falls back to public dev defaults.

# Public contact details shown on the site
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Origine de production (ex: https://mon-domaine.com) — sert à injecter
# canonical / og:url / og:image au build (voir inject-site-meta, vite.config.ts).
# Sur Netlify, inutile : la variable URL fournie par la plateforme est utilisée.
VITE_SITE_URL=

# Apps Script endpoint — NOTE: en prod, le front ne l'appelle PAS directement.
# Il POST sur /.netlify/functions/contact, qui relaie côté serveur vers cette URL.
# La vraie config se met donc dans Netlify (Site settings → Environment) :
#   GOOGLE_SCRIPT_URL = <URL /exec du déploiement Apps Script>
# Voir google-apps-script/Code.gs pour le script à coller + les étapes d'install.
# Cette variable VITE_ ne sert que de repli build-time pour la fonction Netlify.
VITE_GOOGLE_SCRIPT_URL=
